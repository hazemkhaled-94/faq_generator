# How a review sample is drawn. Tuning rather than credentials, so it is
# here and in git like configs/env/backend.env; Argilla's port and workspace
# are in configs/env/deployment.env and its key is in .env.

# How many records one push puts in front of a reviewer.
#
# A review is a sample. This corpus holds twenty thousand facts and nobody
# is reading them, so what the sample has to be is representative rather
# than large: it is spread evenly over the checker's verdicts, so a push
# shows the accepted beside each reason for refusal instead of two hundred
# rows of whatever was extracted first.
#
# Split across the groups, and at least one from each - a rejection code
# that fired twice in a whole corpus is the interesting one, and a
# proportional sample would never show it.
REVIEW_SAMPLE_SIZE=200

# Read and not used: nothing records who reviewed a row.
# REVIEW_REVIEWER=
